# ============================================
# DA-PFC Project .gitignore
# ============================================

# --- 仿真输出 (数据文件太大, 不应入库) ---
# 忽略 outputs 下的所有内容, 但保留 sweep 结果
outputs/*
!outputs/sweep_*/
outputs/sweep_*/*
!outputs/sweep_*/*.json
!outputs/sweep_*/*.png

# --- Checkpoints (包含 final_state tensor, 不应入库) ---
checkpoints/

# --- 二进制数据文件 ---
*.pkl
*.pth
*.h5
*.hdf5
*.npy
*.npz
*.mat
*.dat
*.bin

# --- Python 缓存 ---
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
*.egg
dist/
build/
*.so
*.pyd
*.pyd
.pytest_cache/
.coverage
htmlcov/
.cache/
.mypy_cache/

# --- Jupyter Notebook ---
.ipynb_checkpoints/
*.ipynb_checkpoints/*
*.ipynb
!*.ipynb  # 除非特别需要，一般不提交ipynb文件
.ipynb

# --- IDE / 编辑器 ---
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# --- 操作系统 ---
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
*.lnk

# --- 临时文件 ---
tmp/
*.log
*.tmp
project_report.txt

# --- 临时分析脚本 (根目录散落的临时 py 文件) ---
/analyze_*.py
/check_*.py
/test_*.py

# --- 其他临时文件 ---
_log.txt
_out.txt
_push.txt
push_result.txt
test_out.txt

# --- Sweep 临时文件 ---
sweep_check.txt
sweep_final.txt
sweep_pid.txt
sweep_progress.txt
sweep_status.txt

# --- WM Evaluation outputs ---
wm_eval/outputs/

# --- 虚拟环境 ---
venv/
env/
ENV/
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- 个人配置 ---
config_local.py
*.local.py

# --- 编译文件 ---
*.o
*.d
*.obj
*.exe
*.out
*.app

# --- 文档生成 ---
docs/_build/
docs/build/
site/
_site/
